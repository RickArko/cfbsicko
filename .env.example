# Local SQLite for THIS app. Never point at ~/.cfb_data/cfb.db.
DATABASE_PATH=~/.cfbsicko/locks.db
DATABASE_TYPE=sqlite

HOST=127.0.0.1
PORT=8000
PUBLIC_APP_URL=http://127.0.0.1:8000
WEB_AUTH_ENABLED=true
REQUIRE_EMAIL_CONFIRMED=true

# Dedicated Supabase project (not cfbfantasy).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_FETCH_USER_ON_VERIFY=true

# Site admins. Never * and never real personal addresses in git.
COMMISH_ALLOWED_EMAILS=commish@example.com,ops@example.com

# Resend SMTP (product mail). Auth signup/reset is configured in the Supabase dashboard.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=CFB Sicko <locks@cfbsicko.com>
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Season
CFBSICKO_SEASON=2026
TZ=America/New_York

# Test user password. Off on Fly unless ALLOW_TEST_LOGIN=true is also set.
# make fly.secrets never copies these. Use `make fly.test-login` / `make fly.test-login-off`.
TEST_EMAIL=player@example.com
TEST_PASS=
TEST_DISPLAY_NAME=Rick
ALLOW_TEST_LOGIN=

# Group invite blast. email|Name pairs. Never commit real addresses.
# First address is the review inbox unless `cfbsicko invite-group --to` is set.
# CFBSICKO_TRIAL_ROSTER=commish@example.com|Commish,player@example.com|Player
# Optional file (one email|Name per line). Default ~/.cfbsicko/trial_roster.txt
# CFBSICKO_TRIAL_ROSTER_FILE=

# Optional. Empty = /api/internal/tick returns 404. Same path as the in-process ticks.
CRON_TOKEN=
# Optional thin CFBD key for scores/odds. Empty = ticks no-op unless a feed is injected.
CFBD_API_KEY=

# Never put FLY_API_TOKEN in this file.
